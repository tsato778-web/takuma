# ==============================================================================
# リピスト Phase 1 : DB 接続設定
# .env.example をコピーして .env として使ってください（.env は git 管理対象外）
# ==============================================================================

# ローカル PostgreSQL（Docker で立てる例）
#   docker run --name repisuto-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repisuto?schema=public"

# --- Vercel / Supabase を使う場合の例 ---
# DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
