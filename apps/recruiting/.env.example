# ------------------------------------------------------------
# データベース（Supabase の接続文字列）
# ------------------------------------------------------------
# アプリからの通常接続（コネクションプーラー経由・ポート 6543）
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# マイグレーション実行用の直接接続（ポート 5432）
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# 認証（本部で共有する管理者アカウント1つ）
# ------------------------------------------------------------
# セッション署名用。openssl rand -base64 32 で生成
AUTH_SECRET=""
# ログインID
ADMIN_USER_ID="naoru-recruit"
# パスワード（推奨：npm run auth:hash -- "パスワード" で生成した値を設定）
ADMIN_PASSWORD_HASH=""
# ハッシュを使わず平文で設定する場合はこちら（ADMIN_PASSWORD_HASH が優先される）
# ADMIN_PASSWORD=""
# 本番のURL（Vercel では自動設定されるため通常は不要）
# AUTH_URL="https://recruit.example.com"

# ------------------------------------------------------------
# 初期データ投入（npm run db:seed）
# ログインしない担当者（面談担当・評価者）。「氏名:区分」をカンマ区切り
# 区分: headquarters（本部） | director（院長） | owner（オーナー）
# ------------------------------------------------------------
SEED_MEMBERS="佐藤拓磨:headquarters,若林:headquarters,八尋:headquarters"

# ------------------------------------------------------------
# LINE（Sprint 1 以降で使用）
# ------------------------------------------------------------
# LINE Developers Console → Messaging API チャネル
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# 実送信を止めるスイッチ。既定は true（誤送信防止）。
# 実送信テストを行うときだけ一時的に false にする（読み取りAPIは true でも動作する）
LINE_DRY_RUN="true"

# 送信キューの定期実行（Vercel Cron）を保護するトークン。本番では必須
CRON_SECRET=""

# 受信メディアの保存先（未設定なら保存せずトーク履歴のみ残す）
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_MEDIA_BUCKET="line-media"
